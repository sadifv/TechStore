# Configuración del frontend. No guardar credenciales ni tokens aquí.
# Copiar a .env para desarrollo y ajustar sin compartir valores privados.

# 1. Desarrollo local: proxy de Vite
# Vite lee esta variable al iniciar el servidor de desarrollo.
# No es una variable pública de React ni configura el proxy de Netlify.
BACKEND_PROXY_TARGET=http://localhost:3001

# 2. Aplicación React: origen de API
# Dejar vacío cuando /api y /uploads usan el proxy del mismo dominio.
# Si la API está en otro origen, indicar solo su origen, sin /api.
# Vite incorpora las variables VITE_* al JavaScript público: nunca poner secretos.
VITE_API_BASE_URL=

# 3. Despliegue: proxy de Netlify
# Vercel usa frontend/vercel.json y no necesita esta variable.
# Configurar NETLIFY_BACKEND_URL en las variables de build de Netlify.
# Usar el origen HTTPS de Render, sin rutas, credenciales ni parámetros.
# Es obligatoria cuando NETLIFY=true; sin ella el build se detiene.
# configureProxy.js lee process.env: no carga este .env por sí mismo.
# Para un build local con otro destino, exportarla en la terminal antes de compilar.
NETLIFY_BACKEND_URL=
