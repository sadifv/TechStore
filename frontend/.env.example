# URL que usa el proxy de Vite durante el desarrollo.
BACKEND_PROXY_TARGET=http://localhost:3001

# En despliegues con proxy inverso bajo el mismo dominio, deja vacío.
# Para una API en otro subdominio del mismo sitio, usa su origen HTTPS.
VITE_API_BASE_URL=

# Variable del entorno de build de Netlify. Origen HTTPS del backend de Render.
# Sin valor se conserva el destino de public/_redirects.
NETLIFY_BACKEND_URL=
