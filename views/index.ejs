<%- include('partials/header') %>

<!-- ==========================================
     HERO / INICIO
     ========================================== -->
<section id="inicio" class="hero">
    <article class="hero-content">
        <header>
            <h1>TechStore - Tecnología a tu alcance</h1>
            <p>Descubre los mejores gadgets con envío rápido y garantía asegurada.</p>
        </header>
        <a href="/catalogo" class="btn btn-primary">Ver catálogo completo</a>
    </article>
    <figure class="hero-media">
        <img src="/images/hero-gadgets.jpg" alt="Gadgets tecnológicos destacados" />
    </figure>
</section>

<!-- ==========================================
     OFERTA RELÁMPAGO (FLASH SALE)
     ========================================== -->
<% if (flashSale) { %>
<section class="flash-sale-section" aria-labelledby="flash-sale-title">
    <article class="flash-sale-card">

        <figure class="flash-sale-media">
            <img src="<%= flashSale.image %>" alt="<%= flashSale.name %>" />
            <span class="flash-sale-discount-badge">-<%= flashSale.flashSaleDiscount %>%</span>
        </figure>

        <header class="flash-sale-info">
            <span class="badge flash-sale-badge">🔥 ¡Oferta por Tiempo Limitado!</span>
            <h2 id="flash-sale-title"><%= flashSale.name %></h2>

            <p class="flash-sale-description">
                <%= flashSale.description || 'Aprovecha esta oferta exclusiva por tiempo limitado.' %>
            </p>

            <p class="flash-sale-prices">
                <del>$<%= flashSale.originalPrice.toFixed(2) %></del>
                <strong>$<%= flashSale.price.toFixed(2) %></strong>
            </p>

            <section class="flash-sale-timer" data-ends-at="<%= flashSale.flashSaleEndsAt.toISOString() %>" aria-label="Tiempo restante">
                <p class="flash-sale-timer-label">⏰ Termina en:</p>
                <output class="flash-sale-countdown" aria-live="off">
                    <span class="countdown-block">
                        <strong data-days>--</strong>
                        <small>Días</small>
                    </span>
                    <span class="countdown-block">
                        <strong data-hours>--</strong>
                        <small>Horas</small>
                    </span>
                    <span class="countdown-block">
                        <strong data-minutes>--</strong>
                        <small>Min</small>
                    </span>
                    <span class="countdown-block">
                        <strong data-seconds>--</strong>
                        <small>Seg</small>
                    </span>
                </output>
            </section>

            <a href="/producto/<%= flashSale._id %>" class="btn btn-primary btn-lg flash-sale-cta">
                <i class="ri-shopping-cart-2-line" aria-hidden="true"></i>
                Comprar Ahora
            </a>
        </header>

    </article>
</section>
<% } %>

<!-- ==========================================
     PRODUCTOS DESTACADOS
     ========================================== -->
<section id="destacados" class="products-section" aria-labelledby="featured-heading">
    <header class="section-header">
        <h2 id="featured-heading">Productos Destacados</h2>
    </header>

    <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <ul id="featured-grid" class="products-grid">
            <% products.forEach(product => { %>
                <li>
                    <article class="product-card">

                        <a href="/producto/<%= product._id %>" class="product-card-link" aria-label="Ver detalles de <%= product.name %>">
                            <figure class="product-card-media">
                                <img src="<%= product.image || '/images/placeholder.jpg' %>" alt="<%= product.name %>" loading="lazy" />
                            </figure>
                            <header>
                                <h3><%= product.name %></h3>
                            </header>
                            <p class="product-price">$<%= Number(product.price).toFixed(2) %></p>
                        </a>

                        <footer>
                            <button type="button" class="btn btn-primary add-to-cart-btn" data-id="<%= product._id %>">
                                <i class="ri-shopping-cart-line" aria-hidden="true"></i>
                                Agregar al Carrito
                            </button>
                        </footer>

                    </article>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <ul id="featured-grid" class="products-grid">
            <li class="empty-state-item">
                <p class="empty-msg">No hay productos destacados disponibles en este momento.</p>
            </li>
        </ul>
    <% } %>

    <!-- CTA para dirigir al catálogo completo -->
    <footer class="catalog-cta">
        <a href="/catalogo" class="btn btn-secondary btn-large">
            Ver catálogo completo con filtros y búsqueda →
        </a>
    </footer>
</section>

<!-- ==========================================
     ASISTENTE IA
     ========================================== -->
<section 
  id="ai-assistant" 
  class="ai-section" 
  aria-labelledby="ai-title"
>
  <header class="ai-header">
    <figure class="ai-avatar" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8V4H8"/>
        <rect width="16" height="12" x="4" y="8" rx="2"/>
        <path d="M2 14h2"/>
        <path d="M20 14h2"/>
        <path d="M15 13v2"/>
        <path d="M9 13v2"/>
      </svg>
    </figure>
    <hgroup class="ai-title-group">
      <h2 id="ai-title">Asistente TechBot</h2>
      <p>
        <span class="ai-status" aria-hidden="true"></span>
        <span id="ai-status-text">En línea · Pregúntame sobre cualquier producto</span>
      </p>
    </hgroup>
    <% if (user) { %>
      <button 
        type="button" 
        id="ai-clear-chat" 
        class="ai-clear-btn" 
        aria-label="Limpiar conversación"
        title="Limpiar conversación"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
          <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
      </button>
    <% } %>
  </header>

  <article class="ai-widget" aria-label="Conversación con el asistente virtual">
    
    <% if (!user) { %>
      <!-- ============ ESTADO: Usuario NO logueado ============ -->
      <section 
        class="ai-login-required" 
        aria-label="Inicia sesión para usar el asistente"
      >
        <p class="ai-login-emoji" aria-hidden="true">🔒</p>
        <h3>Inicia sesión para hablar con TechBot</h3>
        <p>Nuestro asistente virtual está disponible solo para usuarios registrados. Es rápido y gratis.</p>
        <nav class="ai-login-actions" aria-label="Acciones de autenticación">
          <a href="/login" class="btn btn-primary">Iniciar sesión</a>
          <a href="/register" class="btn btn-secondary">Crear cuenta</a>
        </nav>
      </section>

    <% } else { %>
      <!-- ============ ESTADO: Usuario logueado ============ -->
      <section 
        id="ai-chat-messages" 
        class="ai-history" 
        aria-live="polite" 
        aria-atomic="false"
      >
        <section id="ai-empty-state" class="ai-empty" aria-label="Sugerencias iniciales">
          <p class="ai-empty-emoji" aria-hidden="true">👋</p>
          <h3>¡Hola! Soy TechBot</h3>
          <p>Estoy aquí para ayudarte a encontrar el producto perfecto. Prueba con una de estas preguntas:</p>
          <ul class="ai-suggestions">
            <li>
              <button type="button" class="ai-suggestion" data-message="¿Qué laptops tienes disponibles?">
                💻 ¿Qué laptops tienes disponibles?
              </button>
            </li>
            <li>
              <button type="button" class="ai-suggestion" data-message="Busco unos auriculares con cancelación de ruido">
                🎧 Busco auriculares con cancelación de ruido
              </button>
            </li>
            <li>
              <button type="button" class="ai-suggestion" data-message="¿Cuál es el mejor smartphone calidad-precio?">
                📱 Mejor smartphone calidad-precio
              </button>
            </li>
          </ul>
        </section>
      </section>

      <form id="ai-chat-form" class="ai-form" autocomplete="off">
        <fieldset class="ai-fieldset">
          <legend class="ai-sr-only">Escribe tu consulta al asistente</legend>
          <label for="ai-chat-input" class="ai-sr-only">Mensaje</label>
          <input
            id="ai-chat-input"
            type="text"
            name="message"
            placeholder="Escribe tu consulta..."
            required
            maxlength="500"
          />
          <button type="submit" class="ai-send" aria-label="Enviar mensaje">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m22 2-7 20-4-9-9-4Z"/>
              <path d="M22 2 11 13"/>
            </svg>
          </button>
        </fieldset>
      </form>
    <% } %>
  </article>
</section>

<!-- ==========================================
     BLOG
     ========================================== -->
<section id="blog" class="blog-section">
    <header class="section-header">
        <h2>Últimas Novedades en Tecnología</h2>
    </header>
    <ul class="blog-grid">
        <li>
            <article class="blog-card">
                <img src="/images/blog-gadgets.jpg" alt="Top Gadgets del Año" />
                <header class="blog-content">
                    <h3>Los mejores Gadgets para potenciar tu Setup en 2026</h3>
                    <p>Descubre los accesorios indispensables para optimizar tu espacio de trabajo.</p>
                </header>
            </article>
        </li>
        <li>
            <article class="blog-card">
                <img src="/images/blog-headphones.jpg" alt="Guía de Audífonos" />
                <header class="blog-content">
                    <h3>Guía de compra: Audífonos con Cancelación de Ruido</h3>
                    <p>Te enseñamos a elegir el modelo ideal según tu presupuesto y necesidades.</p>
                </header>
            </article>
        </li>
        <li>
            <article class="blog-card">
                <img src="/images/blog-smartwatch.jpg" alt="Smartwatches recomendados" />
                <header class="blog-content">
                    <h3>Smartwatches: Monitoreo de salud y rendimiento</h3>
                    <p>Analizamos las funciones clave de los relojes inteligentes más avanzados.</p>
                </header>
            </article>
        </li>
    </ul>
</section>

<!-- ==========================================
     TESTIMONIOS
     ========================================== -->
<section class="testimonials-section">
    <header class="section-header">
        <h2>Lo que dicen nuestros clientes</h2>
    </header>
    <ul class="testimonials-grid">
        <li>
            <article class="testimonial-card">
                <img src="/images/testimonial-carlos.jpg" alt="Foto de Carlos M." />
                <blockquote>"Excelente servicio y entrega rapidísima. Los audífonos llegaron en perfecto estado."</blockquote>
                <cite>- Carlos M.</cite>
            </article>
        </li>
        <li>
            <article class="testimonial-card">
                <img src="/images/testimonial-laura.jpg" alt="Foto de Laura G." />
                <blockquote>"Compré una cámara y un smartwatch. La calidad superó mis expectativas totalmente."</blockquote>
                <cite>- Laura G.</cite>
            </article>
        </li>
        <li>
            <article class="testimonial-card">
                <img src="/images/testimonial-maria.jpg" alt="Foto de María R." />
                <blockquote>"El asistente de IA me ayudó a elegir el cargador correcto para mis dispositivos."</blockquote>
                <cite>- María R.</cite>
            </article>
        </li>
    </ul>
</section>

<!-- ==========================================
     NEWSLETTER
     ========================================== -->
<section class="newsletter-section">
    <article class="newsletter-container">
        <figure class="newsletter-media">
            <img src="/images/newsletter.jpg" alt="Boletín de novedades" class="newsletter-img" />
        </figure>
        <header class="newsletter-content">
            <h2>Suscríbete a nuestras ofertas</h2>
            <p>Recibe cupones de descuento exclusivos y entérate antes que nadie de los lanzamientos.</p>
            
            <form id="newsletter-form" action="/api/newsletter" method="POST" class="newsletter-form">
                <p class="form-field">
                    <input type="email" id="newsletter-email" name="email" placeholder="Ingresa tu correo electrónico" required />
                </p>
                <button type="submit" class="btn btn-primary">Suscribirme</button>
            </form>
            
            <output id="newsletter-status" class="form-status" for="newsletter-form"></output>
        </header>
    </article>
</section>

<!-- ==========================================
     SCRIPTS DE LA HOME
     ========================================== -->
<script src="/js/flash-sale.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>" defer></script>

<!-- Partial: Contacto -->
<%- include('partials/contact') %>

<%- include('partials/footer') %>