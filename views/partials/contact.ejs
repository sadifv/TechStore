<section id="contacto" class="contact-section">
  <h2>Contacto</h2>
  <form action="/api/contact" method="POST" class="contact-form" id="contact-form">
    <fieldset class="form-group">
      <label for="name">Nombre</label>
      <input type="text" id="name" name="name" placeholder="Tu nombre completo" required />
    </fieldset>

    <fieldset class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="tu@email.com" required />
    </fieldset>

    <fieldset class="form-group">
      <label for="message">Mensaje</label>
      <textarea id="message" name="message" rows="5" placeholder="¿En qué te podemos ayudar?" required></textarea>
    </fieldset>

    <button type="submit" class="btn btn-primary">Enviar mensaje</button>
    <output id="contact-status" class="form-status" for="contact-form"></output>
  </form>
</section>