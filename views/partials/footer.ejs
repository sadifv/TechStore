</main>

<!-- Panel Lateral Semántico del Carrito -->
<aside id="cart-drawer" class="cart-drawer" aria-hidden="true" aria-label="Carrito de compras">
    <section class="cart-drawer-overlay" id="cart-overlay"></section>
    <section class="cart-drawer-content">
        <header class="cart-drawer-header">
            <h3><i class="ri-shopping-cart-2-line"></i> Tu Carrito</h3>
            <button id="cart-close-btn" class="cart-close-btn" type="button" aria-label="Cerrar carrito">
                <i class="ri-close-line"></i>
            </button>
        </header>

        <section id="cart-drawer-body" class="cart-drawer-body">
            <!-- Los elementos se insertan dinámicamente mediante createElement -->
        </section>

        <footer class="cart-drawer-footer">
            <p class="cart-summary-row">
                <span>Subtotal:</span>
                <strong id="cart-total">$0.00</strong>
            </p>
            <button id="cart-checkout-btn" type="button" class="btn btn-primary btn-block">
                Proceder al Pago
            </button>
        </footer>
    </section>
</aside>

<!-- Modal Semántico de Checkout / Confirmación de Pago -->
<dialog id="checkout-modal" class="checkout-modal">
    <div class="modal-container">
        <header class="modal-header">
            <h3><i class="ri-secure-payment-line"></i> Finalizar Compra</h3>
            <button id="close-checkout-modal" type="button" class="modal-close-btn" aria-label="Cerrar modal">
                <i class="ri-close-line"></i>
            </button>
        </header>
        
        <form id="checkout-form" class="modal-body">
            <div class="form-group">
                <label for="payment-method">Método de Pago</label>
                <select id="payment-method" name="paymentMethod" class="form-control" required>
                    <option value="card">Tarjeta de Crédito / Débito</option>
                    <option value="transfer">Transferencia Bancaria Directa</option>
                    <option value="cash">Pago contra entrega (Efectivo)</option>
                </select>
            </div>

            <div class="checkout-summary-box">
                <span>Monto Total a Pagar:</span>
                <strong id="checkout-modal-total">$0.00</strong>
            </div>

            <div id="checkout-status" class="form-status" aria-live="polite"></div>

            <footer class="modal-footer">
                <button type="submit" id="btn-confirm-order" class="btn btn-primary btn-block">
                    Confirmar Pedido
                </button>
            </footer>
        </form>
    </div>
</dialog>

<footer class="footer" role="contentinfo">
    <section class="footer-info">
        <h3><i class="ri-store-line"></i> TechStore</h3>
        <p>Tu tienda de tecnología de confianza. Ofrecemos los mejores productos con la mejor garantía y servicio.</p>
    </section>
    
    <section class="footer-links">
        <h4>Enlaces rápidos</h4>
        <ul>
            <li><a href="/#inicio">Inicio</a></li>
            <li><a href="/#catalogo">Catálogo</a></li>
            <li><a href="/#contacto">Contacto</a></li>
            <li><a href="/#ia-assistant">IA Assistant</a></li>
        </ul>
    </section>
    
    <section class="footer-contact">
        <h4>Contacto</h4>
        <address>
            <p><i class="ri-map-pin-line"></i> Av. Tecnológica 123, Ciudad Digital</p>
            <p><i class="ri-phone-line"></i> +34 900 123 456</p>
            <p><i class="ri-mail-line"></i> info@techstore.es</p>
        </address>
    </section>
    
    <section class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> TechStore. Todos los derechos reservados.</p>
        <p class="footer-legal">
            <a href="/privacidad">Política de privacidad</a>
            <span aria-hidden="true">·</span>
            <a href="/terminos">Términos y condiciones</a>
            <span aria-hidden="true">·</span>
            <a href="/cookies">Cookies</a>
        </p>
    </section>
</footer>

