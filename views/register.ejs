<main class="auth-container container">
    <article class="auth-card">
        <header class="auth-header">
            <h1>Crear Cuenta</h1>
            <p>Regístrate para comenzar a comprar en TechStore</p>
        </header>

        <form id="register-form" action="/api/auth/register" method="POST" class="auth-form" novalidate>
            <fieldset class="form-group">
                <label for="reg-name">Nombre Completo</label>
                <input type="text" id="reg-name" name="name" required autocomplete="name" placeholder="Tu nombre" />
            </fieldset>

            <fieldset class="form-group">
                <label for="reg-email">Correo Electrónico</label>
                <input type="email" id="reg-email" name="email" required autocomplete="email" placeholder="correo@ejemplo.com" />
            </fieldset>

            <fieldset class="form-group">
                <label for="reg-password">Contraseña</label>
                <input type="password" id="reg-password" name="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
            </fieldset>

            <button type="submit" class="btn btn-primary">Crear Cuenta</button>

            <p class="auth-redirect">
                ¿Ya tienes una cuenta? <a href="/login">Inicia sesión aquí</a>
            </p>

            <output id="register-status" class="form-status" for="register-form" aria-live="polite"></output>
        </form>
    </article>
</main>

<script src="/js/register.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>