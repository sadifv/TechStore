<main class="auth-container container">
    <article class="auth-card">
        <header class="auth-header">
            <h1>Crear Cuenta</h1>
            <p>Regístrate para comenzar a comprar en TechStore</p>
        </header>

        <form id="register-form" action="/api/auth/register" method="POST">
            <p class="form-field">
                <label for="reg-name">Nombre Completo</label>
                <input type="text" id="reg-name" name="name" required placeholder="Tu nombre" />
            </p>

            <p class="form-field">
                <label for="reg-email">Correo Electrónico</label>
                <input type="email" id="reg-email" name="email" required placeholder="correo@ejemplo.com" />
            </p>

            <p class="form-field">
                <label for="reg-password">Contraseña</label>
                <input type="password" id="reg-password" name="password" required minlength="6" placeholder="******" />
            </p>

            <footer class="form-actions">
                <button type="submit" class="btn btn-primary">Registrarse</button>
            </footer>

            <p class="auth-redirect">
                ¿Ya tienes una cuenta? <a href="/login">Inicia sesión aquí</a>
            </p>

            <output id="register-status" class="status-message"></output>
        </form>
    </article>
</main>

<script src="/js/register.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>