<section class="login-container container" aria-labelledby="reset-password-heading">
  <article class="login-card">
    <h1 id="reset-password-heading">Nueva Contraseña</h1>
    <p class="auth-description">
      Ingresa tu nueva contraseña para actualizar tu cuenta.
    </p>

    <form id="reset-password-form" class="auth-form" action="/api/auth/reset-password/<%= token %>" method="POST" novalidate>
      <input type="hidden" id="reset-token" value="<%= token %>" />

      <fieldset class="form-group">
        <label for="new-password">Nueva Contraseña</label>
        <input type="password" id="new-password" name="password" required minlength="6" autocomplete="new-password" placeholder="••••••••" />
      </fieldset>

      <button type="submit" class="btn btn-primary">Guardar Contraseña</button>

      <output id="reset-status" class="form-status" for="reset-password-form" aria-live="polite"></output>
    </form>
  </article>
</section>

<script src="/js/reset-password.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>