<section
    class="container membership-page"
    data-membership-panel
    data-authenticated="true"
    data-payment-mode="mock"
    aria-labelledby="mock-payment-heading"
>
    <article class="membership-card membership-checkout-card">
        <span class="membership-eyebrow">ENTORNO DE DESARROLLO</span>
        <h1 id="mock-payment-heading">Confirmar pago de prueba</h1>
        <p>Esta pantalla simula el pago de $<%= monthlyPrice.toFixed(2) %> por 30 días. No se solicitarán datos de tarjeta ni se procesará un cobro real.</p>
        <form id="mock-payment-form">
            <input type="hidden" name="token" value="<%= token %>">
            <button type="submit" class="btn btn-primary">Confirmar activación de prueba</button>
        </form>
        <p id="membership-status" class="membership-status" aria-live="polite"></p>
    </article>
</section>
<script src="/js/membership.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>" defer></script>
