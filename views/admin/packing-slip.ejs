<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Packing Slip - TechStore</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="packing-slip">
    <main class="packing-main">
        <header class="packing-header">
            <p class="packing-logo">TechStore</p>
            <h1 class="packing-doc-title">Packing Slip #<%= order._id.toString().slice(-8).toUpperCase() %></h1>
        </header>

        <section class="packing-section" aria-labelledby="packing-customer-heading">
        <h2 id="packing-customer-heading" class="packing-section-title">Información del Cliente</h2>
        <dl class="packing-info-list">
            <div class="packing-info-row">
                <dt class="packing-info-label">Nombre:</dt>
                <dd class="packing-info-value"><%= order.guestInfo?.name || order.user?.name || 'N/A' %></dd>
            </div>
            <div class="packing-info-row">
                <dt class="packing-info-label">Email:</dt>
                <dd class="packing-info-value"><%= order.guestInfo?.email || order.user?.email || 'N/A' %></dd>
            </div>
            <div class="packing-info-row">
                <dt class="packing-info-label">Dirección:</dt>
                <dd class="packing-info-value">
                    <%= order.shippingAddress?.street || 'Dirección estándar' %>,
                    <%= order.shippingAddress?.city || 'Guayaquil' %>,
                    <%= order.shippingAddress?.country || 'Ecuador' %>
                </dd>
            </div>
        </dl>
        </section>

        <section class="packing-section" aria-labelledby="packing-order-heading">
        <h2 id="packing-order-heading" class="packing-section-title">Detalles del Pedido</h2>
        <dl class="packing-info-list">
            <div class="packing-info-row">
                <dt class="packing-info-label">Fecha:</dt>
                <dd class="packing-info-value">
                    <time datetime="<%= new Date(order.createdAt).toISOString() %>"><%= new Date(order.createdAt).toLocaleDateString('es-EC') %></time>
                </dd>
            </div>
            <div class="packing-info-row">
                <dt class="packing-info-label">Estado:</dt>
                <dd class="packing-info-value"><%= order.status %></dd>
            </div>
            <div class="packing-info-row">
                <dt class="packing-info-label">Pago:</dt>
                <dd class="packing-info-value"><%= order.paymentStatus %></dd>
            </div>
        </dl>
        </section>

        <section class="packing-section" aria-labelledby="packing-products-heading">
        <h2 id="packing-products-heading" class="packing-section-title">Productos</h2>
        <table class="packing-table">
            <caption class="sr-only">Productos incluidos en la orden</caption>
            <thead>
                <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Precio Unit.</th>
                    <th scope="col">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach(item => { %>
                <tr>
                    <td><%= item.product?.name || item.productName || 'Producto' %></td>
                    <td><%= item.quantity %></td>
                    <td>$<%= Number(item.price).toFixed(2) %></td>
                    <td>$<%= Number(item.price * item.quantity).toFixed(2) %></td>
                </tr>
                <% }) %>
            </tbody>
            <tfoot>
                <tr class="packing-total-row">
                    <th scope="row" colspan="3">Total:</th>
                    <td><strong>$<%= Number(order.totalAmount).toFixed(2) %></strong></td>
                </tr>
            </tfoot>
        </table>
        </section>

        <footer class="packing-footer">
            <address>TechStore - Villa España, Guayaquil, Ecuador | <a href="tel:+593963976623">+593 0963976623</a></address>
        </footer>
    </main>
</body>
</html>
