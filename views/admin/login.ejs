<%- include('../partials/header') %>

<main class="login-container container">
  <section class="login-card">
    <h2>Iniciar Sesión</h2>
    <form id="login-form" action="/admin/login" method="POST" class="auth-form">
      
      <fieldset class="form-group">
        <label for="login-email">Correo Electrónico</label>
        <input type="email" id="login-email" name="email" required placeholder="correo@ejemplo.com" />
      </fieldset>

      <fieldset class="form-group">
        <label for="login-password">Contraseña</label>
        <input type="password" id="login-password" name="password" required placeholder="••••••••" />
      </fieldset>

      <button type="submit" class="btn btn-primary">Ingresar</button>
      
      <p class="auth-redirect">
        ¿No tienes una cuenta? <a href="/register">Regístrate aquí</a>
      </p>

      <output id="login-status" class="form-status" for="login-form"></output>
    </form>
  </section>
</main>

<script src="/js/login.js"></script>
<%- include('../partials/footer') %>