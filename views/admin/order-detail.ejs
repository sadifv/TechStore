<section class="admin-container container order-detail-page" aria-labelledby="order-detail-heading">
  <header class="admin-header">
    <div class="admin-header-main">
      <a href="/admin/orders" class="btn btn-outline btn-sm">&larr; Volver a Órdenes</a>
      <h1 id="order-detail-heading">Detalle de Orden #<%= order._id %></h1>
    </div>
    <div class="admin-header-actions">
      <a href="/admin/orders/<%= order._id %>/packing-slip" target="_blank" rel="noopener" class="btn btn-secondary">
        <i class="ri-printer-line" aria-hidden="true"></i> Imprimir Packing Slip
      </a>
    </div>
  </header>

  <div class="order-detail-grid">
    <article class="order-card">
      <h2>Información del Cliente</h2>
      <% if (order.user) { %>
        <p><strong>Nombre:</strong> <%= order.user.name %></p>
        <p><strong>Email:</strong> <%= order.user.email %></p>
      <% } else if (order.guestInfo) { %>
        <p><strong>Nombre:</strong> <%= order.guestInfo.name %> (Invitado)</p>
        <p><strong>Email:</strong> <%= order.guestInfo.email %></p>
      <% } else { %>
        <p>Cliente sin información registrada</p>
      <% } %>
      <p><strong>Fecha de Orden:</strong> <%= new Date(order.createdAt).toLocaleString('es-EC') %></p>
    </article>

    <article class="order-card">
      <h2>Estado del Pedido</h2>
      <fieldset class="form-group">
        <label for="order-detail-status">Estado Actual:</label>
        <select id="order-detail-status" class="form-control select-order-status" data-order-id="<%= order._id %>" data-current-status="<%= order.status %>" <%= order.paymentStatus !== 'paid' || order.status === 'completed' || order.status === 'cancelled' ? 'disabled' : '' %>>
          <% const allowedStatuses = order.paymentStatus !== 'paid' ? [order.status] : order.status === 'pending' ? ['pending', 'processing'] : order.status === 'processing' ? ['processing', 'shipped'] : order.status === 'shipped' ? ['shipped', 'delivered'] : order.status === 'delivered' ? ['delivered', 'completed'] : [order.status]; %>
          <% allowedStatuses.forEach(status => { %>
            <option value="<%= status %>" selected><%= ({ pending: 'Pendiente', processing: 'En proceso', shipped: 'Enviado', delivered: 'Entregado', completed: 'Completado', cancelled: 'Cancelado' })[status] || status %></option>
          <% }); %>
        </select>
        <% if (order.paymentStatus !== 'paid') { %>
          <small class="text-muted">El estado de envío se habilita después de confirmar el pago.</small>
        <% } %>
      </fieldset>
    </article>
  </div>

  <section class="order-items-section">
    <h2>Productos Comprados</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Producto</th>
          <th scope="col">Precio Unitario</th>
          <th scope="col">Cantidad</th>
          <th scope="col">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td>
              <% if (item.product) { %>
                <strong><%= item.product.name %></strong>
              <% } else { %>
                <em>Producto no disponible o eliminado</em>
              <% } %>
            </td>
            <td>$<%= item.price.toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3" class="text-right">Total General:</th>
          <td><strong>$<%= order.totalAmount.toFixed(2) %></strong></td>
        </tr>
      </tfoot>
    </table>
  </section>
</section>

<script src="/js/admin-crud.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>