<section class="admin-container container" aria-labelledby="admin-dashboard-heading">
  <header class="admin-header">
    <h1 id="admin-dashboard-heading"><i class="ri-dashboard-line" aria-hidden="true"></i> Panel de Administración</h1>
  </header>

  <section class="dashboard-stats" aria-label="Resumen de ventas">
    <h2 class="sr-only">Resumen de ventas</h2>
      <article class="stat-card">
        <h3>Órdenes Totales</h3>
        <p class="stat-number"><%= totalOrders %></p>
      </article>
      <article class="stat-card">
        <h3>Ingresos Pagados</h3>
        <p class="stat-number">$<%= Number(totalRevenue).toFixed(2) %></p>
      </article>
      <article class="stat-card">
        <h3>Productos Vendidos</h3>
        <p class="stat-number"><%= totalProductsSold %></p>
      </article>
      <article class="stat-card">
        <h3>Carritos Activos</h3>
        <p class="stat-number"><%= activeCartCount %></p>
      </article>
  </section>

  <section class="dashboard-orders" aria-label="Órdenes recientes">
    <div class="section-heading">
      <h2 class="section-title">Órdenes Recientes</h2>
      <a href="/admin/orders" class="btn btn-sm btn-outline">Ver todas</a>
    </div>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Cliente</th>
            <th scope="col">Total</th>
            <th scope="col">Estado</th>
            <th scope="col">Fecha</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders && orders.length > 0) { %>
            <% orders.forEach(function(order, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <% if (order.user) { %>
                    <%= order.user.name %> <small><%= order.user.email %></small>
                  <% } else if (order.guestInfo) { %>
                    <%= order.guestInfo.name %> (Invitado)
                  <% } else { %>
                    Invitado
                  <% } %>
                </td>
                <td>$<%= Number(order.totalAmount || 0).toFixed(2) %></td>
                <td><span class="status-<%= order.status %>"><%= order.status %></span></td>
                <td>
                  <%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('es-EC') : 'N/A' %>
                </td>
                <td>
                  <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-primary">Ver</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">No hay órdenes registradas.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-products" aria-label="Productos más vendidos">
    <h2 class="section-title">Productos Más Vendidos</h2>
    <div class="products-grid">
      <% if (topProducts && topProducts.length > 0) { %>
        <% topProducts.forEach(function(product) { %>
          <article class="product-card">
            <a href="/producto/<%= product._id %>">
              <img src="<%= product.image || '/images/default-product.png' %>" alt="<%= product.name %>">
              <h4><%= product.name %></h4>
            </a>
            <p class="product-price">$<%= Number(product.price || 0).toFixed(2) %></p>
            <small><%= product.unitsSold %> vendidos</small>
          </article>
        <% }); %>
      <% } else { %>
        <p class="empty-msg">Todavía no hay productos vendidos.</p>
      <% } %>
    </div>
  </section>
</section>
