<section class="admin-container container" aria-labelledby="admin-dashboard-heading">
  <header class="admin-header">
    <h1 id="admin-dashboard-heading"><i class="ri-dashboard-line" aria-hidden="true"></i> Panel de Administración</h1>
    <a href="/admin/marketing" class="btn btn-primary">Marketing y membresías</a>
  </header>

  <section class="dashboard-stats" aria-label="Resumen de ventas">
    <h2 class="sr-only">Resumen de ventas</h2>
      <article class="stat-card">
        <h3>Órdenes Totales</h3>
        <p class="stat-number"><%= totalOrders %></p>
      </article>
      <article class="stat-card">
        <h3>Ingresos Pagados</h3>
        <p class="stat-number">$<%= Number(totalRevenue).toFixed(2) %></p>
      </article>
      <article class="stat-card">
        <h3>Productos Vendidos</h3>
        <p class="stat-number"><%= totalProductsSold %></p>
      </article>
      <article class="stat-card">
        <h3>Carritos Activos</h3>
        <p class="stat-number"><%= activeCartCount %></p>
      </article>
      <article class="stat-card">
        <h3>Membresías VIP Activas</h3>
        <p class="stat-number"><%= activeMembershipCount %></p>
      </article>
  </section>

  <section class="dashboard-memberships" aria-labelledby="active-memberships-heading">
    <header class="section-heading">
      <div>
        <h2 id="active-memberships-heading" class="section-title">Suscripciones VIP activas</h2>
        <p class="membership-dashboard-note">Se muestran las membresías vigentes; la lista presenta hasta 100 usuarios.</p>
      </div>
      <a href="/admin/marketing" class="btn btn-sm btn-outline">Gestionar campañas y cupones</a>
    </header>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Usuario</th>
            <th scope="col">Inicio del período</th>
            <th scope="col">Vigente hasta</th>
            <th scope="col">Precio</th>
            <th scope="col">Proveedor</th>
            <th scope="col">Estado de renovación</th>
          </tr>
        </thead>
        <tbody>
          <% if (activeMemberships && activeMemberships.length > 0) { %>
            <% activeMemberships.forEach(membership => { %>
              <% const periodStart = membership.currentPeriodStart ? new Date(membership.currentPeriodStart) : null; %>
              <% const periodEnd = membership.currentPeriodEnd ? new Date(membership.currentPeriodEnd) : null; %>
              <tr>
                <td>
                  <% if (membership.user) { %>
                    <strong><%= membership.user.name || 'Usuario' %></strong><br>
                    <a href="mailto:<%= membership.user.email %>"><%= membership.user.email %></a>
                  <% } else { %>
                    Cuenta de usuario no disponible
                  <% } %>
                </td>
                <td><%= periodStart && !Number.isNaN(periodStart.getTime()) ? periodStart.toLocaleDateString('es-EC') : 'N/A' %></td>
                <td><%= periodEnd && !Number.isNaN(periodEnd.getTime()) ? periodEnd.toLocaleDateString('es-EC') : 'N/A' %></td>
                <td><%= membership.currency || 'USD' %> $<%= Number(membership.amount || 0).toFixed(2) %></td>
                <td><%= membership.provider === 'mock' ? 'Prueba (sin cobro)' : membership.provider %></td>
                <td><%= membership.cancelAtPeriodEnd ? 'Cancelada al finalizar el período' : 'Activa' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">No hay membresías VIP activas en este momento.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-orders" aria-label="Órdenes recientes">
    <div class="section-heading">
      <h2 class="section-title">Órdenes Recientes</h2>
      <a href="/admin/orders" class="btn btn-sm btn-outline">Ver todas</a>
    </div>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Cliente</th>
            <th scope="col">Total</th>
            <th scope="col">Estado</th>
            <th scope="col">Fecha</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders && orders.length > 0) { %>
            <% orders.forEach(function(order, index) { %>
              <% const orderDate = order.createdAt ? new Date(order.createdAt) : null; %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <% if (order.user) { %>
                    <%= order.user.name %> <small><%= order.user.email %></small>
                  <% } else if (order.guestInfo) { %>
                    <%= order.guestInfo.name %> (Invitado)
                  <% } else { %>
                    Invitado
                  <% } %>
                </td>
                <td>$<%= Number(order.totalAmount || 0).toFixed(2) %></td>
                <td><span class="status-<%= order.status %>"><%= order.status %></span></td>
                <td>
                  <%= orderDate && !Number.isNaN(orderDate.getTime()) ? orderDate.toLocaleDateString('es-EC') : 'N/A' %>
                </td>
                <td>
                  <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-primary">Ver</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">No hay órdenes registradas.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-products" aria-labelledby="admin-products-heading">
    <header class="section-heading">
      <h2 id="admin-products-heading" class="section-title">Gestión del catálogo</h2>
      <button type="button" id="btn-open-create-modal" class="btn btn-primary">Nuevo producto</button>
    </header>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Imagen</th>
            <th scope="col">Producto</th>
            <th scope="col">Categoría</th>
            <th scope="col">Precio</th>
            <th scope="col">Stock</th>
            <th scope="col">Oferta</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody id="admin-products-list" aria-live="polite">
          <tr><td colspan="7" class="text-center">Cargando productos...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-messages" aria-labelledby="admin-messages-heading">
    <h2 id="admin-messages-heading" class="section-title">Mensajes de contacto</h2>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Correo</th>
            <th scope="col">Mensaje</th>
            <th scope="col">Fecha</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
              <% const messageDate = msg.createdAt ? new Date(msg.createdAt) : null; %>
              <tr>
                <td><%= msg.name %></td>
                <td><a href="mailto:<%= msg.email %>"><%= msg.email %></a></td>
                <td class="admin-message-content"><%= msg.message %></td>
                <td>
                  <% if (messageDate && !Number.isNaN(messageDate.getTime())) { %>
                    <time datetime="<%= messageDate.toISOString() %>"><%= messageDate.toLocaleDateString('es-EC') %></time>
                  <% } else { %>
                    N/A
                  <% } %>
                </td>
                <td><button type="button" class="btn btn-sm btn-delete btn-delete-message" data-id="<%= msg._id %>">Eliminar</button></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="text-center">No hay mensajes registrados.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-newsletter" aria-labelledby="admin-newsletter-heading">
    <h2 id="admin-newsletter-heading" class="section-title">Suscriptores al boletín</h2>
    <p class="membership-dashboard-note">Mostrando hasta los 100 suscriptores más recientes.</p>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Correo</th>
            <th scope="col">Fecha de suscripción</th>
            <th scope="col">Marketing</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (subscribers && subscribers.length > 0) { %>
            <% subscribers.forEach(sub => { %>
              <% const subscriptionDate = sub.createdAt ? new Date(sub.createdAt) : null; %>
              <tr>
                <td><a href="mailto:<%= sub.email %>"><%= sub.email %></a></td>
                <td>
                  <% if (subscriptionDate && !Number.isNaN(subscriptionDate.getTime())) { %>
                    <time datetime="<%= subscriptionDate.toISOString() %>"><%= subscriptionDate.toLocaleDateString('es-EC') %></time>
                  <% } else { %>
                    N/A
                  <% } %>
                </td>
                <td><%= sub.isSubscribed === false ? 'Dio de baja' : 'Activo' %></td>
                <td><button type="button" class="btn btn-sm btn-delete btn-delete-subscriber" data-id="<%= sub._id %>">Eliminar</button></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4" class="text-center">No hay suscriptores registrados.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dashboard-products" aria-label="Productos más vendidos">
    <h2 class="section-title">Productos Más Vendidos</h2>
    <div class="products-grid">
      <% if (topProducts && topProducts.length > 0) { %>
        <% topProducts.forEach(function(product) { %>
          <article class="product-card">
            <a href="/producto/<%= product._id %>">
              <img src="<%= product.image || '/images/products/product-placeholder.svg' %>" alt="<%= product.name %>">
              <h4><%= product.name %></h4>
            </a>
            <p class="product-price">$<%= Number(product.price || 0).toFixed(2) %></p>
            <small><%= product.unitsSold %> vendidos</small>
          </article>
        <% }); %>
      <% } else { %>
        <p class="empty-msg">Todavía no hay productos vendidos.</p>
      <% } %>
    </div>
  </section>
</section>

<dialog id="product-modal" class="modal-dialog">
  <article class="modal-card">
    <header class="modal-header">
      <h2 id="modal-title">Agregar producto</h2>
      <button type="button" id="btn-close-modal" class="btn-close" aria-label="Cerrar">&times;</button>
    </header>
    <form id="product-form" enctype="multipart/form-data">
      <input type="hidden" id="product-id" name="id" />
      <p class="form-field">
        <label for="prod-name">Nombre del producto</label>
        <input type="text" id="prod-name" name="name" required minlength="2" maxlength="100" />
      </p>
      <p class="form-field">
        <label for="prod-description">Descripción</label>
        <textarea id="prod-description" name="description" rows="3" required></textarea>
      </p>
      <fieldset class="form-group-inline">
        <p class="form-field">
          <label for="prod-price">Precio ($)</label>
          <input type="number" id="prod-price" name="price" step="0.01" min="0.01" required />
        </p>
        <p class="form-field">
          <label for="prod-stock">Stock</label>
          <input type="number" id="prod-stock" name="stock" min="0" step="1" required />
        </p>
      </fieldset>
      <p class="form-field">
        <label for="prod-category">Categoría</label>
        <select id="prod-category" name="category" required>
          <option value="">Selecciona una categoría</option>
          <option value="Laptops">Laptops</option>
          <option value="Smartphones">Smartphones</option>
          <option value="Audio">Audio</option>
          <option value="Accesorios">Accesorios</option>
          <option value="Periféricos">Periféricos</option>
          <option value="Monitores">Monitores</option>
          <option value="Almacenamiento">Almacenamiento</option>
          <option value="Componentes">Componentes</option>
          <option value="Gaming">Gaming</option>
          <option value="Redes">Redes</option>
        </select>
      </p>
      <p class="form-field">
        <label for="prod-image-file">Imagen del producto (opcional)</label>
        <input type="file" id="prod-image-file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" />
      </p>
      <p class="form-field">
        <label for="prod-image">URL de imagen (si no subes un archivo)</label>
        <input type="url" id="prod-image" name="image" placeholder="https://..." />
      </p>
      <figure class="form-field image-preview-container">
        <figcaption>Vista previa</figcaption>
        <img id="prod-image-preview" src="/images/products/product-placeholder.svg" alt="Vista previa del producto" />
      </figure>
      <footer class="modal-actions">
        <button type="button" id="btn-cancel-modal" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar producto</button>
      </footer>
    </form>
  </article>
</dialog>

<dialog id="flash-sale-modal" class="modal-dialog">
  <article class="modal-card">
    <header class="modal-header">
      <h2>Configurar oferta relámpago</h2>
      <button type="button" id="btn-close-flash-modal" class="btn-close" aria-label="Cerrar">&times;</button>
    </header>
    <form id="flash-sale-form">
      <input type="hidden" id="flash-product-id" />
      <p class="form-field">
        <span>Producto</span>
        <output id="flash-product-name" class="flash-product-name">-</output>
      </p>
      <p class="form-field">
        <span>Precio actual</span>
        <output id="flash-current-price" class="flash-current-price" data-price="0">$0.00</output>
      </p>
      <fieldset class="form-group-inline">
        <p class="form-field">
          <label for="flash-discount">Descuento (%)</label>
          <input type="number" id="flash-discount" name="discount" min="1" max="90" value="20" required />
        </p>
        <p class="form-field">
          <label for="flash-duration">Duración (horas)</label>
          <input type="number" id="flash-duration" name="durationHours" min="1" max="168" value="24" required />
        </p>
      </fieldset>
      <p class="form-field">
        <span>Precio final</span>
        <output id="flash-final-price" class="flash-final-price" aria-live="polite">$0.00</output>
      </p>
      <footer class="modal-actions">
        <button type="button" id="btn-cancel-flash-modal" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Activar oferta</button>
      </footer>
    </form>
  </article>
</dialog>
