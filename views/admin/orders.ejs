<section class="admin-container container admin-orders-page" aria-labelledby="admin-orders-heading">
  <header class="admin-header">
    <h1 id="admin-orders-heading"><i class="ri-shopping-bag-line" aria-hidden="true"></i> Gestión de Órdenes</h1>
    <nav class="admin-filter-nav" aria-label="Filtro de estados">
      <a href="/admin/orders" class="btn btn-sm <%= !currentStatus ? 'btn-primary' : 'btn-outline' %>">Todas</a>
      <a href="/admin/orders?status=pending" class="btn btn-sm <%= currentStatus === 'pending' ? 'btn-primary' : 'btn-outline' %>">Pendientes</a>
      <a href="/admin/orders?status=processing" class="btn btn-sm <%= currentStatus === 'processing' ? 'btn-primary' : 'btn-outline' %>">En Proceso</a>
      <a href="/admin/orders?status=shipped" class="btn btn-sm <%= currentStatus === 'shipped' ? 'btn-primary' : 'btn-outline' %>">Enviadas</a>
      <a href="/admin/orders?status=completed" class="btn btn-sm <%= currentStatus === 'completed' ? 'btn-primary' : 'btn-outline' %>">Completadas</a>
      <a href="/admin/orders?status=cancelled" class="btn btn-sm <%= currentStatus === 'cancelled' ? 'btn-primary' : 'btn-outline' %>">Canceladas</a>
    </nav>
  </header>

  <section class="admin-table-wrapper" aria-label="Listado de órdenes">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">ID Orden</th>
          <th scope="col">Cliente</th>
          <th scope="col">Fecha</th>
          <th scope="col">Total</th>
          <th scope="col">Estado Pago</th>
          <th scope="col">Estado Envío</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td><code>#<%= order._id %></code></td>
              <td>
                <% if (order.user) { %>
                  <strong><%= order.user.name %></strong><br>
                  <small><%= order.user.email %></small>
                <% } else if (order.guestInfo) { %>
                  <strong><%= order.guestInfo.name %> (Invitado)</strong><br>
                  <small><%= order.guestInfo.email %></small>
                <% } else { %>
                  <em>Cliente Desconocido</em>
                <% } %>
              </td>
              <td><time datetime="<%= new Date(order.createdAt).toISOString() %>"><%= new Date(order.createdAt).toLocaleDateString('es-EC') %></time></td>
              <td><strong>$<%= order.totalAmount.toFixed(2) %></strong></td>
              <td>
                <span class="badge badge-<%= order.paymentStatus === 'paid' ? 'success' : 'warning' %>">
                  <%= order.paymentStatus === 'paid' ? 'Pagado' : 'Pendiente' %>
                </span>
              </td>
              <td>
                <label class="sr-only" for="order-status-<%= order._id %>">Estado de la orden #<%= order._id %></label>
                <select id="order-status-<%= order._id %>" class="form-control select-order-status" data-order-id="<%= order._id %>" data-current-status="<%= order.status %>" <%= order.paymentStatus !== 'paid' || order.status === 'completed' || order.status === 'cancelled' ? 'disabled' : '' %>>
                  <% const allowedStatuses = order.paymentStatus !== 'paid' ? [order.status] : order.status === 'pending' ? ['pending', 'processing'] : order.status === 'processing' ? ['processing', 'shipped'] : order.status === 'shipped' ? ['shipped', 'delivered'] : order.status === 'delivered' ? ['delivered', 'completed'] : [order.status]; %>
                  <% allowedStatuses.forEach(status => { %>
                    <option value="<%= status %>" selected><%= ({ pending: 'Pendiente', processing: 'En proceso', shipped: 'Enviado', delivered: 'Entregado', completed: 'Completado', cancelled: 'Cancelado' })[status] || status %></option>
                  <% }); %>
                </select>
                <% if (order.paymentStatus !== 'paid') { %><small class="text-muted">Disponible después del pago</small><% } %>
              </td>
              <td>
                <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-secondary" title="Ver Detalle">
                  <i class="ri-eye-line" aria-hidden="true"></i> Detalle
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center">No se encontraron órdenes registradas.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <% if (pagination && pagination.totalPages > 1) { %>
    <nav class="pagination-nav" aria-label="Navegación de páginas">
      <% if (pagination.currentPage > 1) { %>
        <a href="/admin/orders?page=<%= pagination.currentPage - 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>" class="btn btn-sm btn-outline">Anterior</a>
      <% } %>
      <span>Página <%= pagination.currentPage %> de <%= pagination.totalPages %></span>
      <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="/admin/orders?page=<%= pagination.currentPage + 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>" class="btn btn-sm btn-outline">Siguiente</a>
      <% } %>
    </nav>
  <% } %>
</section>

<script src="/js/admin-crud.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>