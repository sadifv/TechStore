<section class="login-container container" aria-labelledby="login-heading">
  <article class="login-card">
    <h1 id="login-heading">Iniciar Sesión</h1>
    <form id="login-form" action="/login" method="POST" class="auth-form">
      
      <fieldset class="form-group">
        <label for="login-email">Correo Electrónico</label>
        <input type="email" id="login-email" name="email" autocomplete="email" required placeholder="correo@ejemplo.com" />
      </fieldset>

      <fieldset class="form-group">
        <label for="login-password">Contraseña</label>
        <input type="password" id="login-password" name="password" autocomplete="current-password" required placeholder="••••••••" />
      </fieldset>

      <p class="auth-forgot-link">
        <a href="/forgot-password" class="link-secondary">¿Olvidaste tu contraseña?</a>
      </p>

      <button type="submit" class="btn btn-primary">Ingresar</button>
      
      <p class="auth-redirect">
        ¿No tienes una cuenta? <a href="/register">Regístrate aquí</a>
      </p>

      <output id="login-status" class="form-status" for="login-form" aria-live="polite"></output>
    </form>
  </article>
</section>

<script src="/js/login.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>