<section id="contacto" class="contact-section" aria-labelledby="contact-title">
  <header class="contact-header">
    <h2 id="contact-title">Contáctanos</h2>
    <p>¿Tienes alguna pregunta? Estamos aquí para ayudarte</p>
  </header>

  <section class="contact-grid">
    
    <!-- Columna izquierda: Info de contacto -->
    <aside class="contact-info" aria-label="Información de contacto">
      <ul class="contact-info-list">
        <li class="contact-info-item">
          <i class="ri-mail-line" aria-hidden="true"></i>
          <section>
            <h3>Email</h3>
            <a href="mailto:sadiflores20201@gmail.com">sadiflores20201@gmail.com</a>
          </section>
        </li>
        <li class="contact-info-item">
          <i class="ri-phone-line" aria-hidden="true"></i>
          <section>
            <h3>Teléfono</h3>
            <a href="tel:+593 0963976623">+593 0963976623</a>
          </section>
        </li>
        <li class="contact-info-item">
          <i class="ri-map-pin-line" aria-hidden="true"></i>
          <section>
            <h3>Dirección</h3>
            <address>Villa España<br>Guayaquil, Ecuador</address>
          </section>
        </li>
        <li class="contact-info-item">
          <i class="ri-time-line" aria-hidden="true"></i>
          <section>
            <h3>Horario</h3>
            <p>Lunes a Viernes<br>9:00 - 16:00</p>
          </section>
        </li>
      </ul>

      <nav class="contact-socials" aria-label="Redes sociales">
        <a href="https://instagram.com/tu_usuario" target="_blank" rel="noopener" aria-label="Instagram">
          <i class="ri-instagram-line" aria-hidden="true"></i>
        </a>
      </nav>
    </aside>

    <!-- Columna derecha: Formulario -->
    <form 
      id="contact-form" 
      class="contact-form" 
      action="/api/contact" 
      method="POST"
      novalidate
    >
      <fieldset class="form-field">
        <legend class="sr-only">Nombre</legend>
        <label for="contact-name">Nombre</label>
        <input 
          type="text" 
          id="contact-name" 
          name="name" 
          placeholder="Tu nombre completo" 
          required 
          minlength="2"
          maxlength="80"
          autocomplete="name"
        />
      </fieldset>

      <fieldset class="form-field">
        <legend class="sr-only">Email</legend>
        <label for="contact-email">Email</label>
        <input 
          type="email" 
          id="contact-email" 
          name="email" 
          placeholder="tu@email.com" 
          required 
          autocomplete="email"
        />
      </fieldset>

      <fieldset class="form-field">
        <legend class="sr-only">Mensaje</legend>
        <label for="contact-message">Mensaje</label>
        <textarea 
          id="contact-message" 
          name="message" 
          rows="5" 
          placeholder="¿En qué te podemos ayudar?" 
          required 
          minlength="10"
          maxlength="1000"
        ></textarea>
      </fieldset>

      <button type="submit" class="btn btn-primary btn-block">
        <i class="ri-send-plane-line" aria-hidden="true"></i>
        Enviar mensaje
      </button>

      <output 
        id="contact-status" 
        class="form-status" 
        for="contact-form"
        aria-live="polite"
      ></output>
    </form>
  </section>
</section>