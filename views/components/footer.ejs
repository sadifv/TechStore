<!-- ==========================================
     CARRITO (DRAWER LATERAL)
     ========================================== -->
<aside id="cart-drawer" class="cart-drawer" aria-hidden="true" aria-label="Carrito de compras">
    <section class="cart-drawer-overlay" id="cart-overlay"></section>
    <section class="cart-drawer-content">
        <header class="cart-drawer-header">
            <h3><i class="ri-shopping-cart-2-line" aria-hidden="true"></i> Tu Carrito</h3>
            <button id="cart-close-btn" class="cart-close-btn" type="button" aria-label="Cerrar carrito">
                <i class="ri-close-line" aria-hidden="true"></i>
            </button>
        </header>

        <section id="cart-drawer-body" class="cart-drawer-body" aria-label="Productos en el carrito">
            <!-- Los elementos se insertan dinámicamente -->
        </section>

        <footer class="cart-drawer-footer">
            <p class="cart-summary-row">
                <span>Subtotal:</span>
                <strong id="cart-total">$0.00</strong>
            </p>
            <button id="cart-checkout-btn" type="button" class="btn btn-primary btn-block">
                <i class="ri-secure-payment-line" aria-hidden="true"></i>
                Proceder al Pago
            </button>
        </footer>
    </section>
</aside>

<!-- ==========================================
     MODAL DE CHECKOUT
     ========================================== -->
<dialog id="checkout-modal" class="checkout-modal" aria-labelledby="checkout-modal-title">
    <form id="checkout-form" class="modal-container" method="dialog">

        <header class="modal-header">
            <h3 id="checkout-modal-title">
                <i class="ri-secure-payment-line" aria-hidden="true"></i>
                Finalizar Compra
            </h3>
            <button id="close-checkout-modal" type="button" class="modal-close-btn" aria-label="Cerrar modal">
                <i class="ri-close-line" aria-hidden="true"></i>
            </button>
        </header>

        <% if (typeof user === 'undefined' || !user) { %>
            <fieldset class="form-group" id="guest-checkout-fields">
                <legend>Datos del Comprador</legend>
                <p class="form-field">
                    <label for="guest-name">Nombre Completo</label>
                    <input type="text" id="guest-name" name="guestName" class="form-control" placeholder="Ej. Juan Pérez" required />
                </p>
                <p class="form-field">
                    <label for="guest-email">Correo Electrónico para Recibo</label>
                    <input type="email" id="guest-email" name="guestEmail" class="form-control" placeholder="correo@ejemplo.com" required />
                </p>
            </fieldset>
        <% } %>

        <fieldset class="form-group">
            <legend>Método de Pago</legend>
            <label for="payment-method" class="sr-only">Selecciona tu método de pago</label>
            <select id="payment-method" name="paymentMethod" class="form-control" required>
                <option value="card">Tarjeta de Crédito / Débito</option>
                <option value="transfer">Transferencia Bancaria Directa</option>
                <option value="cash">Pago contra entrega (Efectivo)</option>
            </select>
        </fieldset>

        <section class="checkout-summary-box" aria-label="Resumen del pago">
            <span>Monto Total a Pagar:</span>
            <strong id="checkout-modal-total">$0.00</strong>
        </section>

        <output id="checkout-status" class="form-status" aria-live="polite"></output>

        <footer class="modal-footer">
            <button type="submit" id="btn-confirm-order" class="btn btn-primary btn-block">
                <i class="ri-check-line" aria-hidden="true"></i>
                Confirmar Pedido
            </button>
        </footer>

    </form>
</dialog>

