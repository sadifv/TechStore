<nav class="navbar" aria-label="Navegación principal">
    <a href="/#inicio" class="navbar-logo" aria-label="TechStore - Inicio">
        <i class="ri-store-line" aria-hidden="true"></i>
        <span>TechStore</span>
    </a>
    
    <button type="button" class="navbar-toggle" aria-expanded="false" aria-controls="navbar-menu" aria-label="Abrir menú">
        <i class="ri-menu-line" aria-hidden="true"></i>
    </button>
    
    <ul id="navbar-menu" class="navbar-menu">
        <li><a href="/#inicio"><i class="ri-home-line" aria-hidden="true"></i> Inicio</a></li>
        <li><a href="/catalogo"><i class="ri-shopping-bag-line" aria-hidden="true"></i> Catálogo</a></li>
        <li><a href="/vip"><i class="ri-vip-crown-line" aria-hidden="true"></i> VIP</a></li>
        <li><a href="/#contacto"><i class="ri-mail-line" aria-hidden="true"></i> Contacto</a></li>
        <li><a href="/#ai-assistant"><i class="ri-robot-line" aria-hidden="true"></i> IA Assistant</a></li>

        <!-- Ícono del Carrito con Contador -->
        <li>
            <button type="button" id="cart-btn" class="cart-btn-nav" aria-label="Ver carrito">
                <i class="ri-shopping-cart-2-line" aria-hidden="true"></i>
                <span id="cart-count" class="cart-badge">0</span>
            </button>
        </li>

        <% if (typeof user !== 'undefined' && user) { %>
            <!-- Enlace al Perfil del Usuario -->
            <li>
                <a href="/profile" class="user-greeting" title="Ver mi perfil">
                    <i class="ri-user-smile-line" aria-hidden="true"></i> <%= user.name %>
                </a>
            </li>

            <% if (user.role === 'admin') { %>
                <!-- Acceso al Panel para Administradores -->
                <li>
                    <a href="/admin/dashboard" class="btn btn-primary">
                        <i class="ri-user-settings-line" aria-hidden="true"></i> Panel Admin
                    </a>
                </li>
            <% } %>

            <!-- Botón de Salir/Logout -->
            <li>
                <form action="/api/auth/logout" method="POST" class="navbar-logout-form">
                    <button type="submit" class="btn btn-secondary">
                        <i class="ri-logout-box-r-line" aria-hidden="true"></i> Salir
                    </button>
                </form>
            </li>
        <% } else { %>
            <!-- Usuario Invitado (Sin Sesión Activa) -->
            <li>
                <a href="/login" class="btn btn-secondary">
                    <i class="ri-user-line" aria-hidden="true"></i> Iniciar Sesión
                </a>
            </li>
            <li>
                <a href="/register" class="btn btn-primary">
                    <i class="ri-user-add-line" aria-hidden="true"></i> Registrarse
                </a>
            </li>
        <% } %>
    </ul>
</nav>