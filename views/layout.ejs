<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'TechStore' %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <%- include('components/navbar') %>

    <main id="main-content" class="main-content">
        <%- body %>
    </main>

    <%- include('components/footer') %>

    <script src="/js/main.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>" defer></script>
    <% if (typeof title !== 'undefined' && title === 'Catálogo de Productos - TechStore') { %>
        <script src="/js/catalog.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>" defer></script>
    <% } %>
</body>
</html>