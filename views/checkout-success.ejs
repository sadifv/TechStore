<section
    class="checkout-success-container"
    aria-labelledby="checkout-success-heading"
    data-guest-order="<%= order.user ? 'false' : 'true' %>"
    data-purchased-items="<%= JSON.stringify(order.items.map(item => ({ productId: String(item.product), quantity: item.quantity }))) %>"
>
    <article class="success-card">
        <header>
            <i class="ri-checkbox-circle-line checkout-success-icon" aria-hidden="true"></i>
            <h1 id="checkout-success-heading">¡Gracias por tu compra!</h1>
        </header>

        <section class="order-details" aria-label="Resumen del pedido">
            <p>Tu pedido con ID <strong><%= order._id %></strong> ha sido procesado correctamente.</p>
            <p>Total pagado: <strong>$<%= Number(order.totalAmount).toFixed(2) %></strong></p>
            <% if (Number(order.discountAmount || 0) > 0) { %>
                <p>Cupón <strong><%= order.couponCode %></strong>: descuento de <strong>$<%= Number(order.discountAmount).toFixed(2) %></strong></p>
            <% } %>
            <p>Hemos actualizado nuestro inventario y pronto prepararemos tu paquete.</p>
        </section>
        <script src="/js/checkout-success.js" defer></script>

        <footer>
            <a href="/catalogo" class="btn btn-primary">Volver al Catálogo</a>
        </footer>
    </article>
</section>