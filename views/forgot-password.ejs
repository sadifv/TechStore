<main class="login-container container">
  <section class="login-card">
    <h2>Recuperar Contraseña</h2>
    <p style="text-align: center; color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem;">
      Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
    </p>

    <form id="forgot-password-form" class="auth-form">
      <fieldset class="form-group">
        <label for="forgot-email">Correo Electrónico</label>
        <input type="email" id="forgot-email" name="email" required placeholder="correo@ejemplo.com" />
      </fieldset>

      <button type="submit" class="btn btn-primary">Enviar enlace</button>

      <p class="auth-redirect">
        <a href="/login">← Volver al inicio de sesión</a>
      </p>

      <output id="forgot-status" class="form-status" aria-live="polite"></output>
    </form>
  </section>
</main>

<script src="/js/forgot-password.js?v=<%= process.env.NODE_ENV === 'development' ? Date.now() : '1.0.0' %>"></script>