<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmación de Pedido - TechStore</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="standalone-page confirmation-page">
    <main class="standalone-card">
        <header class="standalone-brand">
            <p>TechStore</p>
        </header>

        <p class="confirmation-icon" aria-hidden="true">&#10004;</p>
        <h1 class="standalone-heading">¡Confirmación de tu pedido!</h1>

        <section class="standalone-order-details" aria-label="Resumen del pedido">
            <dl>
                <div>
                    <dt>Pedido:</dt>
                    <dd>#<%= orderId.toString().slice(-8).toUpperCase() %></dd>
                </div>
                <div>
                    <dt>Total:</dt>
                    <dd>$<%= Number(totalAmount).toFixed(2) %></dd>
                </div>
                <div>
                    <dt>Fecha:</dt>
                    <dd><time datetime="<%= new Date().toISOString() %>"><%= new Date().toLocaleDateString('es-EC') %></time></dd>
                </div>
            </dl>
        </section>

        <p class="standalone-message">Hemos recibido tu pedido correctamente. Te enviaremos un correo con los detalles.</p>

        <nav class="standalone-actions" aria-label="Acciones">
            <a href="/" class="btn btn-primary">Volver a la tienda</a>
        </nav>

        <footer class="standalone-footer">
            <address>TechStore - Villa España, Guayaquil, Ecuador</address>
        </footer>
    </main>
</body>
</html>
