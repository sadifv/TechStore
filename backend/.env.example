# Puerto en el que escuchará el servidor Express.
PORT=3001

# Entorno de ejecución. Usa production al desplegar.
NODE_ENV=development

# Saltos de proxy confiables: 0 en local; usa 1 detrás de un único Nginx.
TRUST_PROXY_HOPS=0

# Orígenes exactos desde los que React llamará al backend, separados por comas.
# En producción reemplaza estos orígenes por la URL HTTPS pública de React.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URI de MongoDB para el uso diario de la aplicación.
MONGO_URI=mongodb://127.0.0.1:27017/techstore

# URI exclusiva para la prueba de integración; el nombre debe terminar en _test.
MONGO_TEST_URI=mongodb://127.0.0.1:27017/techstore_integration_test

# Secreto aleatorio para firmar las sesiones; usa al menos 32 bytes en producción.
SESSION_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_bytes

# Clave secreta Stripe. Usa sk_test_ en desarrollo y sk_live_ solo en producción.
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_de_stripe

# Clave pública Stripe correspondiente a STRIPE_SECRET_KEY.
STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_de_stripe

# Secreto del webhook Stripe configurado para este entorno.
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_de_webhook

# URL pública de React, usada para enlaces de correo y retornos de Checkout VIP.
# Debe ser HTTPS en producción.
APP_URL=http://localhost:5173

# URL pública de React para redirigir las rutas de página antiguas de Express.
FRONTEND_URL=http://localhost:5173

# Origen público del backend; en producción usa HTTPS. Checkout Stripe vuelve a esta URL.
API_URL=http://localhost:3001

# Método de pago VIP: mock solo funciona en development; usa stripe para Stripe Checkout.
MEMBERSHIP_PAYMENT_MODE=mock

# Precio mensual público/servidor de la membresía VIP, en dólares.
VIP_MONTHLY_PRICE=4.99

# Compra mínima para aplicar descuentos de cupones VIP.
VIP_COUPON_MIN_ORDER=50

# Porcentaje del cupón VIP de bienvenida.
VIP_WELCOME_DISCOUNT_PERCENT=15

# Descuento máximo en dólares del cupón VIP de bienvenida.
VIP_WELCOME_MAX_DISCOUNT=10

# Porcentaje del cupón mensual VIP.
VIP_MONTHLY_DISCOUNT_PERCENT=10

# Descuento máximo en dólares del cupón mensual VIP.
VIP_MONTHLY_MAX_DISCOUNT=8

# Usuario SMTP para el envío de correos; déjalo vacío para simular envíos.
SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación SMTP correspondiente a SMTP_USER.
SMTP_PASS=tu_password_de_aplicacion

# Clave API de Gemini usada por el asistente de IA.
GEMINI_API_KEY=tu_api_key_de_gemini

# Correo que usará el script opcional de creación del administrador.
ADMIN_EMAIL=admin@techstore.com

# Contraseña temporal segura que usará el script opcional de creación del administrador.
ADMIN_PASSWORD=definir_una_contrasena_segura_para_el_seed
