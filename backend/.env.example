# Puerto en el que escuchará el servidor Express.
PORT=3001

# Entorno de ejecución. Usa production al desplegar.
NODE_ENV=development

# Saltos de proxy confiables: 0 en local; usa 1 detrás de un único Nginx.
TRUST_PROXY_HOPS=0

# Orígenes exactos desde los que React llamará al backend, separados por comas.
# En producción reemplaza estos orígenes por la URL HTTPS pública de React.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URI de MongoDB para el uso diario de la aplicación.
MONGO_URI=mongodb://127.0.0.1:27017/techstore

# Opcional: servidores DNS para Node si el DNS del sistema no resuelve registros SRV de MongoDB Atlas.
# Déjalo vacío en producción si el proveedor ya resuelve Atlas correctamente.
MONGO_DNS_SERVERS=

# URI exclusiva para la prueba de integración; el nombre debe terminar en _test.
MONGO_TEST_URI=mongodb://127.0.0.1:27017/techstore_integration_test

# Secreto aleatorio para firmar las sesiones; usa al menos 32 bytes en producción.
SESSION_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_bytes

# Número de WhatsApp de la tienda, con código de país y solo dígitos.
WHATSAPP_BUSINESS_PHONE=593963976623

# URL pública de React, usada para enlaces de correo.
# Debe ser HTTPS en producción.
APP_URL=http://localhost:5173

# URL pública de React para redirigir las rutas de página antiguas de Express.
FRONTEND_URL=http://localhost:5173

# Origen público del backend; en producción usa HTTPS.
API_URL=http://localhost:3001

# Usuario SMTP para el envío de correos; déjalo vacío para simular envíos.
SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación SMTP correspondiente a SMTP_USER.
SMTP_PASS=tu_password_de_aplicacion

# Clave API de Gemini usada por el asistente de IA.
GEMINI_API_KEY=tu_api_key_de_gemini

# Correo que usará el script opcional de creación del administrador.
ADMIN_EMAIL=admin@techstore.com

# Contraseña temporal segura que usará el script opcional de creación del administrador.
ADMIN_PASSWORD=definir_una_contrasena_segura_para_el_seed
