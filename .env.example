# Servidor
PORT=3001
NODE_ENV=development

# Orígenes permitidos separados por comas (obligatorio en producción)
ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Base de Datos
MONGO_URI=mongodb://127.0.0.1:27017/techstore
# Base aislada solo para npm run test:integration (debe terminar en _test)
MONGO_TEST_URI=mongodb://127.0.0.1:27017/techstore_integration_test

# Sesiones
SESSION_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_bytes

# Stripe de prueba
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_de_stripe
STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_de_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_de_webhook

# URL pública usada por Checkout VIP (HTTPS obligatorio en producción)
APP_URL=http://localhost:3001

# Membresía VIP: mock solo en desarrollo; stripe usa Checkout recurrente
MEMBERSHIP_PAYMENT_MODE=mock
VIP_MONTHLY_PRICE=4.99
VIP_COUPON_MIN_ORDER=50
VIP_WELCOME_DISCOUNT_PERCENT=15
VIP_WELCOME_MAX_DISCOUNT=10
VIP_MONTHLY_DISCOUNT_PERCENT=10
VIP_MONTHLY_MAX_DISCOUNT=8

# Gmail (SMTP)
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion

# Gemini AI
GEMINI_API_KEY=tu_api_key_de_gemini

# Admin Seed (opcional, para scripts/seedAdmin.js)
ADMIN_EMAIL=admin@techstore.com
ADMIN_PASSWORD=definir_una_contrasena_segura_para_el_seed
